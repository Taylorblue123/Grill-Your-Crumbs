# LLM 接入。key / 模型名 / base_url 全走环境变量，代码里零硬编码。
# 换厂商只改这里：把 base_url 指向对方的 OpenAI 兼容端点、改掉模型名即可。
GRILL_LLM_API_KEY=sk-your-key-here
GRILL_LLM_MODEL=gpt-5-mini
# 留空 = OpenAI 官方。
GRILL_LLM_BASE_URL=
GRILL_LLM_TIMEOUT_SECONDS=60

# 存储路径（默认全在仓库根的 data/ 下，已 gitignore）。
# GRILL_DATABASE_PATH=./data/grill.db
# GRILL_UPLOAD_DIR=./data/uploads
# 拷问会话的 dev 镜像：会话本体在内存里，这只是重启回读用的快照。
# 里面永不含 token。
# GRILL_SESSION_MIRROR_PATH=./data/grill-sessions.json
