# Optional Chat Completions-compatible model endpoint for Live mode.
# Replay and Live both work with the deterministic fallback when these are unset.
GRILL_LLM_API_URL=
GRILL_LLM_MODEL=
GRILL_LLM_API_KEY=
GRILL_LLM_TIMEOUT=30

# Runtime settings
GRILL_DATA_DIR=data
GRILL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
